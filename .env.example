# Port the app listens on. A PORT set by the host (Hostinger web hosting, Docker, pm2) always wins over
# this file. On Hostinger web hosting do NOT set PORT in hPanel — Hostinger assigns it.
PORT=3000

# First-run setup: open /admin in your browser and create your super admin account there.
# SETUP_KEY protects that page until you've done it (you'll be asked for this key). Use a random string.
SETUP_KEY=
# (Alternative: create the super admin automatically on first start instead of the setup page)
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=

# Enables https://yourdomain.com/api/cron?key=CRON_KEY — call it every 5 minutes from a cron job or an
# uptime monitor: it wakes the app if the host stopped it and reconnects dropped WhatsApp numbers.
CRON_KEY=

# Where all data and WhatsApp logins are stored. Leave empty for automatic:
# on Hostinger web hosting → /home/<user>/domains/<domain>/app-storage (survives redeploys),
# elsewhere → data/ and sessions/ next to server.js.
STORAGE_DIR=

# Reverse proxy in front of the app (for correct visitor IPs). Leave empty for automatic.
# Docker + Traefik: 1
TRUST_PROXY=

# Only used once, when upgrading from the single-company version: the name of the workspace
# your existing data is moved into.
COMPANY_NAME=My Company

# Defaults for every workspace's campaign throttling (each workspace can change these on its Block Risk page)
MIN_DELAY_MS=8000
MAX_DELAY_MS=20000
DAILY_LIMIT_PER_SESSION=500

# Support tickets (apply to all workspaces)
# Open a ticket automatically for every incoming WhatsApp message (true/false)
AUTO_TICKETS=true
# A customer reply within this many days reopens a resolved ticket; after that a new ticket is created
TICKET_REOPEN_DAYS=7
# Sent when a new ticket is opened ({{ticket}}, {{name}} available). Set to "off" to disable.
TICKET_AUTO_REPLY="Thanks for contacting us! Your ticket #{{ticket}} has been created. Our team will reply shortly."
# Sent when an agent marks a ticket resolved. Set to "off" to disable.
TICKET_RESOLVED_MESSAGE="Your ticket #{{ticket}} has been resolved. Reply to this chat if you need more help."

# Plans, prices, trial length, brand name and payment instructions are edited in the /admin panel.
# Each workspace sets its own webhook URL on its Subscription page.
